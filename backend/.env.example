# SUPPLYMIND Configuration
# Copy this to .env and fill in your keys

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplymind

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB

# LLM Provider (groq)
LLM_PROVIDER=groq

# Groq API Key (for LLM generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embedding Provider (huggingface, openai, cohere, voyage)
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI (if using for embeddings or LLM)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (if using for LLM)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cohere (if using for embeddings)
# COHERE_API_KEY=...
# COHERE_EMBEDDING_MODEL=embed-english-v3.0

# Voyage AI (if using for embeddings)
# VOYAGE_API_KEY=...
# VOYAGE_EMBEDDING_MODEL=voyage-2

# Ollama (local LLM)
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB persist directory
CHROMA_PERSIST_DIR=./chroma_db

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging
LOG_LEVEL=INFO