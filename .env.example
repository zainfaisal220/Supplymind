# SUPPLYMIND Configuration
# Copy this file to backend/.env (or root .env) and set your keys

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplymind

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB

# LLM Provider (groq)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Vector Embedding Provider (huggingface, openai, cohere, voyage)
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Persistent Storage
CHROMA_PERSIST_DIR=./chroma_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO
